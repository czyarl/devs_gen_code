# Fill in the key for the model provider you use. No key is needed to evaluate existing programs.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# NEBIUS_API_KEY=

# Optional provider endpoint overrides:
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: proxy reachable from the SWE-Agent Docker container.
# DEVS_SWE_CONTAINER_HTTP_PROXY=http://host.docker.internal:7890
# DEVS_SWE_CONTAINER_HTTPS_PROXY=http://host.docker.internal:7890
# DEVS_SWE_CONTAINER_NO_PROXY=localhost,127.0.0.1,::1
# DEVS_SWE_DOCKER_IMAGE=python-xdevs-simpy

# Optional: use existing Python environments instead of .venvs/ under this project.
# Give absolute paths to the Python executables; the runner also prepends each
# executable's directory to PATH so commands such as `sweagent` are found.
# DEVS_GEN_PYTHON=/path/to/devs-gen/bin/python
# DEVS_OPENHANDS_PYTHON=/path/to/openhands/bin/python
# DEVS_SWEAGENT_PYTHON=/path/to/sweagent/bin/python
