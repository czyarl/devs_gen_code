            "time": 10.0,
            "type": "control",
            "value": 1
          },
          {
            "time": 60.0,
            "type": "request",
            "value": 1
          }
        ]
      },
      "sim_stdin": "00:00:10 control 1\n00:01:00 request 1\n"
    },
    {
