{
  "protocol_version": "0.1.0",
  "benchmark_version": "saa-0.1.1",
  "scenario_id": "SAA",
  "display_name": "Secure Area Access Control",
  "trace_schema": {
    "time_type": "number",
    "allow_empty_trace": false,
    "require_nondecreasing_time": true,
    "allow_unknown_events": true,
    "record_adapter": {
      "serialization": "single_json",
      "time_field": "simulation_time",
      "entity_constant": "system",
      "event_constant": "summary",
      "payload_from_remaining": true,
      "raw_fields": [
        {
          "name": "test_name",
          "type": "str"
        },
        {
          "name": "simulation_time",
          "type": "number"
        },
        {
          "name": "initial_state",
          "type": "str"
        },
        {
          "name": "final_state",
          "type": "str"
        },
        {
          "name": "events",
          "type": "list"
        },
        {
          "name": "operations",
          "type": "list"
        }
      ],
      "allow_extra_raw_fields": false,
      "time_scale": 1.0
    },
    "events": [
      {
        "event": "summary",
        "entities": [
          "system"
        ],
        "allow_extra_payload_fields": false,
        "payload_fields": [
          {
            "name": "test_name",
            "type": "str"
          },
          {
            "name": "initial_state",
            "type": "str"
          },
          {
            "name": "final_state",
            "type": "str"
          },
          {
            "name": "events",
            "type": "list"
          },
          {
            "name": "operations",
            "type": "list"
          }
        ]
      }
    ]
  },
  "requirements": [
    {
      "requirement_id": "saa.nested_record_contract",
      "name": "Nested event and operation contract",
      "clause": "Nested events and operations use the declared component, message, state, action, completion, and time value domains.",
      "category": "micro",
      "scope": "case",
      "score_kind": "ratio"
    },
    {
      "requirement_id": "saa.input_accountability",
      "name": "Input event accountability",
      "clause": "Every non-empty input line emits exactly one input_reader event at its converted timestamp with the same {port value} message.",
      "category": "micro",
      "scope": "case",
      "score_kind": "composite",
      "parameters": {
        "absolute_time_tolerance_seconds": 1e-06,
        "basis": "floating-point arithmetic comparison only"
      }
    },
    {
      "requirement_id": "saa.working_policy",
      "name": "Busy-request acceptance policy",
      "clause": "Requests arriving while AlarmAdmin is working are ignored after input; a request at the authentication completion time is accepted, and operations report acceptance and completion correctly.",
      "category": "micro",
      "scope": "case",
      "score_kind": "composite",
      "parameters": {
        "absolute_time_tolerance_seconds": 1e-06,
        "basis": "floating-point arithmetic comparison only"
      }
    },
    {
      "requirement_id": "saa.authentication_pipeline",
      "name": "Authentication pipeline and timing",
      "clause": "Every accepted request produces alarmAdmin, successful authentication, and display events after the configured cumulative delays with the original message and required states.",
      "category": "micro",
      "scope": "case",
      "score_kind": "composite",
      "parameters": {
        "absolute_time_tolerance_seconds": 1e-06,
        "basis": "floating-point arithmetic comparison only"
      }
    },
    {
      "requirement_id": "saa.state_semantics",
      "name": "Visible state semantics",
      "clause": "The system starts Disarmed; accepted values set the visible state, redundant accepted requests still display it, and final_state follows the last accepted request.",
      "category": "macro",
      "scope": "case",
      "score_kind": "ratio"
    },
    {
      "requirement_id": "saa.simulation_bound",
      "name": "Simulation end time",
      "clause": "simulation_time is the last emitted event time, unless max_simulation_time stops the run earlier.",
      "category": "macro",
      "scope": "case",
      "score_kind": "ratio",
      "parameters": {
        "absolute_time_tolerance_seconds": 1e-06,
        "basis": "floating-point arithmetic comparison only"
      }
    }
  ],
  "test_cases": [
    {
      "case_id": "L0_Empty",
      "description": "No operation requests",
      "timeout_sec": 10,
      "sim_args": {
        "test_name": "L0_Empty",
        "input_file": "input_data/test_l0_empty.txt"
      },
      "checker_config": {
        "total_operations": 0,
        "final_state": "Disarmed",
        "state_transitions": [
          "Disarmed"
        ],
        "timing_checks": [],
        "expected_events": [],
        "behavior_checks": {}
      }
    },
    {
      "case_id": "L1_01_Single_Arm",
      "description": "Single arm operation",
      "timeout_sec": 10,
      "sim_args": {
        "test_name": "L1_01_Single_Arm",
        "input_file": "input_data/test_l1_01_single_arm.txt"
      },
      "checker_config": {
        "total_operations": 1,
        "final_state": "Armed",
        "state_transitions": [
          "Disarmed",
          "Armed"
        ],
        "timing_checks": [
          {
            "from": "input",
            "to": "alarmAdmin",
            "expected_delay": 10.0,
            "operation": "all"
          },
          {
            "from": "alarmAdmin",
            "to": "authentication",
            "expected_delay": 2.0,
            "operation": "all"
          },
          {
            "from": "authentication",
            "to": "display",
            "expected_delay": 3.0,
            "operation": "all"
          }
        ],
        "expected_events": [],
        "behavior_checks": {}
      }
    },
